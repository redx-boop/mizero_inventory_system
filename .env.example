# ============================================
# Mizero Inventory Hub — Production .env
# ============================================
# Copy this file to .env.production and fill in
# your values before running docker compose.
#
#   $ cp .env.example .env.production
#   $ docker compose --env-file .env.production up -d
# ============================================

# --- Database ---
# Root password for MySQL (used for initial DB setup)
DB_ROOT_PASSWORD=change_this_root_password

# Application database user (created automatically)
DB_USER=mizero
DB_PASSWORD=change_this_db_password
DB_NAME=mizero_inventory

# --- JWT ---
# Generate a strong secret: openssl rand -hex 64
JWT_SECRET=change_this_jwt_secret_min_32_chars_long
JWT_EXPIRES_IN=24h

# --- Server ---
# The public-facing URL (used for CORS and redirects)
FRONTEND_URL=http://localhost

# The port to expose the application on the host machine
PORT=80
