# ============================================
# Mizero Inventory Hub — Docker Development
# ============================================
# Copy this to .env for local Docker execution:
#
#   cp .env.docker .env
#   docker compose --env-file .env up -d
#
# These are DEVELOPMENT defaults only.
# For production, use .env.production with strong secrets.
# ============================================

# --- Database ---
DB_ROOT_PASSWORD=rootpassword
DB_USER=mizero
DB_PASSWORD=mizero_password
DB_NAME=mizero_inventory

# --- JWT ---
JWT_SECRET=docker-dev-jwt-secret-change-in-production-min-32-chars
JWT_EXPIRES_IN=24h

# --- Server ---
FRONTEND_URL=http://localhost
PORT=80
